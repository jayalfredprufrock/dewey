{
  "name": "@jayalfredprufrock/dewey",
  "version": "0.0.0-semantically-released",
  "description": "An OpenSearch/Elasticsearch client and repository layer designed for typescript",
  "homepage": "https://github.com/jayalfredprufrock/dewey#readme",
  "bugs": {
    "url": "https://github.com/jayalfredprufrock/dewey/issues"
  },
  "license": "MIT",
  "author": "Andrew Smiley <jayalfredprufrock@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayalfredprufrock/dewey.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "search": "docker run --rm -p 9200:9200 -e discovery.type=single-node -e DISABLE_SECURITY_PLUGIN=true -e DISABLE_INSTALL_DEMO_CONFIG=true opensearchproject/opensearch:2.19.0"
  },
  "devDependencies": {
    "@opensearch-project/opensearch": "^3.5.0",
    "@semantic-release/exec": "^7.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "semantic-release": "^25.0.3",
    "typebox": "^1.3.2",
    "vite-plus": "0.2.1",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@elastic/elasticsearch": "^8.0.0 || ^9.0.0",
    "@opensearch-project/opensearch": "^2.0.0 || ^3.0.0",
    "typebox": "^1.1.14"
  },
  "peerDependenciesMeta": {
    "@elastic/elasticsearch": {
      "optional": true
    },
    "@opensearch-project/opensearch": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "pnpm version ${nextRelease.version} --no-git-tag-version",
          "publishCmd": "pnpm publish --no-git-checks"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
